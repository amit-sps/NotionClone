<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Workspace Invitation</title>
    <style>
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
          "Helvetica Neue", Arial, sans-serif;
        background-color: #121212;
        margin: 0;
        padding: 0;
        color: #fff;
      }
      .container {
        width: 100%;
        max-width: 600px;
        margin: 20px auto;
        background-color: #1c1c1e;
        padding: 30px;
        border-radius: 8px;
      }
      .header {
        text-align: left;
        padding: 20px 0;
        border-bottom: 1px solid #333;
        display: flex;
        align-items: center;
        color: #fff;
      }
      .header img {
        width: 32px;
        height: 32px;
      }
      .header h2 {
        flex-grow: 1;
        margin: 0;
        font-size: 24px;
      }
      .content {
        padding: 20px 0;
        line-height: 1.6;
        color: #fff;
      }
      .content p {
        margin: 0 0 15px;
      }
      .content a {
        color: #0366d6;
        text-decoration: none;
      }
      .content a:hover {
        text-decoration: underline;
      }
      .footer {
        text-align: center;
        padding: 20px 0;
        border-top: 1px solid #333;
        font-size: 12px;
        color: #999;
      }
      .footer img {
        width: 100px;
        margin: 20px 0;
      }
      .button {
        display: inline-block;
        padding: 10px 20px;
        margin: 20px 0;
        color: #121212;
        background-color: #fff;
        text-align: center;
        border-radius: 5px;
        text-decoration: none;
        font-weight: bold;
      }
      .button:hover {
        background-color: #f0f0f0;
      }
      p {
        color: #fff;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">
        <img
          src="https://upload.wikimedia.org/wikipedia/commons/4/45/Notion_app_logo.png"
          alt="Notion Logo"
        />
        <h2>Welcome to the team's workspace</h2>
      </div>
      <div class="content">
        <p>Hey,</p>
        <p>
          You have been added to the
          <strong><%= workspaceName %></strong> workspace by <%= addedBy %>.
        </p>
        <p>
          Please log in to your account and check the Teams space for more
          details.
        </p>
        <p>
          <a href="<%= loginUrl %>" class="button">Log in to your account</a>
        </p>
      </div>
      <div class="footer">
        <p>&copy; 2024 Notion. All rights reserved.</p>
      </div>
    </div>
  </body>
</html>
